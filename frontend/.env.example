# Frontend Environment Variables
# For local development, these are all optional (defaults to localhost:8000)
# For production, set these to your Railway backend URL

# API URL — your Railway backend URL + /api
# Example: https://your-app.up.railway.app/api
VITE_API_URL=

# WebSocket URL — your Railway backend domain (no protocol)
# Example: your-app.up.railway.app
VITE_WS_URL=

# Media URL — your Railway backend URL (for images)
# Example: https://your-app.up.railway.app
VITE_MEDIA_URL=
